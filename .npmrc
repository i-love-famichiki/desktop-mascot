# npm のサプライチェーン攻撃（乗っ取られたパッケージ）への備え

# インストールのときに、パッケージ側のスクリプト（preinstall / postinstall など）を動かさない。
# マルウェアはここで動くことが多い。Electron 本体はスクリプトなしで入る（初回起動時に取りに行く）
ignore-scripts=true

# 公開されてから7日たっていないバージョンは入れない。
# 乗っ取りはたいてい数時間〜数日で見つかって消されるので、その間に巻き込まれないようにする
min-release-age=7

# npm 公式サイト以外（GitHub のリポジトリなど）から直接パッケージを取ってこない
allow-git=none

# 追加したパッケージのバージョンを「^」なしで固定して記録する
save-exact=true
