{
  "name": "desktop-mascot",
  "version": "1.0.23",
  "description": "デスクトップに住む枝豆のマスコット",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "mock-history": "node test/make-mock-history.js",
    "icon": "electron build/make-icon.js",
    "tray-icon": "electron build/make-tray-icon.js",
    "dist": "electron-builder --win"
  },
  "keywords": [],
  "author": "i-love-famichiki",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.i-love-famichiki.desktop-mascot",
    "productName": "Desktop Mascot",
    "electronDist": "node_modules/electron/dist",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "main/**",
      "lib/**",
      "windows/**",
      "assets/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Desktop Mascot",
      "artifactName": "DesktopMascot-Setup.${ext}"
    }
  }
}
